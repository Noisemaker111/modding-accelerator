{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python bench/session_state.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python bench/push_guard.py",
            "timeout": 60,
            "statusMessage": "Checking what CI would fail on"
          }
        ]
      }
    ]
  }
}
