	"authors": [
		"Jon"
	],
	"license": "CC0-1.0",
	"icon": "assets/prismlab/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.prismlab.PrismLab"
		],
		"client": [
			"com.prismlab.client.PrismLabClient"
		]
	},
	"mixins": [
		"prismlab.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}



