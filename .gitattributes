#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start scripts should use lf
/fixtures/prism-lab/gradlew text eol=lf
/mmt            text eol=lf
/modaccel       text eol=lf
/tools/cloud-run text eol=lf
*.yml          text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

ROADMAP.md linguist-generated=true
docs/index.html linguist-generated=true
docs/porting-map/** linguist-generated=true

# Candidate diffs are applied with git apply; keep their bytes stable on every OS
*.diff text eol=lf
