# modaccel's own working folders. Scratch output belongs in .runs/, not the repo root.
.tools/
.runs/
.modaccel/
.workers/
.lab/
logs/
run/

# Scratch files a run left beside the sources
.*.log
.*.err
/.*.txt
/.*.png
/.*.bak
/.e[0-9]*.json
/.self-*
/5/
PORT-REPORT.md

# Game files that must never land in the repo root
saves/
world/
screenshots/
options.txt
server.properties
usercache.json

# Harness copies the older Windows lane installs into a version node
versions/*/modaccel.ps1
versions/*/modaccel.cmd
versions/*/tools/
versions/*/check.ps1
versions/*/lint.ps1
versions/*/mp.ps1
versions/*/portlog.ps1
versions/*/LabDaemon.java
versions/*/config/
versions/*/downloads/

# Cloned mods and their logs; only the results are kept
bench/port/*
!bench/port/results.json
bench/mods/*
!bench/mods/results.json
bench/fresh/
bench/fix-test/
bench/scan-test/
