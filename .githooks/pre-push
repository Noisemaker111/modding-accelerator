#!/bin/sh
# Fast offline checks on what this push changes (tools/ci/pre_push.py). Enable once per clone:
#   git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel)
if command -v python3 >/dev/null 2>&1 && python3 -c "" >/dev/null 2>&1; then py=python3; else py=python; fi
exec "$py" "$root/tools/ci/pre_push.py"
