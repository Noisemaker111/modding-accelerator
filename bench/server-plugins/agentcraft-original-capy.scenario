# Original AgentCraft Mineflayer assertions, Capy with Claude Code connected.
needs node
helper-env MOCK_CLAUDE_CODE=1
background capy: node test/mock-capy.mjs ${port:capy}
wait-port ${port:capy} within 15s
server-env AGENTCRAFT_BACKEND=capy
server-env CAPY_API_KEY=capy_mock
server-env CAPY_BASE_URL=http://127.0.0.1:${port:capy}/api/v1
server-property level-seed=
server-property generate-structures=true
server-property allow-flight=false
server-property view-distance=10
server-property simulation-distance=10
server-property max-players=20
server-property sync-chunk-writes=true
server-property network-compression-threshold=256
server-property enforce-secure-profile=true
process-env BACKEND=capy
process-env MOCK_CLAUDE_CODE=1
process-env MOCK_URL=http://127.0.0.1:${port:capy}
start-server
expect-process node "${harness}/bench/server-plugins/agentcraft-original.mjs" ~20/20 checks passed~ within 180s
