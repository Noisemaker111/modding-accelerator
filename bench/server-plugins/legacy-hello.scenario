# The bot on an older Paper server (it joins through ViaProxy) and a plugin built for 1.8.8 answering it.
# Every step works on every Paper line from 1.8.8 up: no 1.13+ block states, no NBT, no JSON text.
expect-log ~LegacyHello enabled on~ within 10s
join
command /hello
expect-chat ~^Hello, ModaccelBot, from LegacyHello$~ within 10s
rcon give ${bot} minecraft:diamond 3
expect-inventory diamond count 3 within 10s
rcon tp ${bot} 0.5 100 0.5
expect-position 0.5 100 0.5 within 10s
rcon setblock 2 100 0 minecraft:gold_block
expect-block 2 100 0 gold_block within 10s
say hello old server
expect-chat ~<ModaccelBot> hello old server~ within 10s
