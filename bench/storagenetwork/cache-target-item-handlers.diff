@@ -0,0 +1,42 @@
+package com.lothrazar.storagenetwork.api.capabilities;
+
+import com.lothrazar.storagenetwork.api.DimPos;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.Level;
+import net.neoforged.neoforge.capabilities.BlockCapabilityCache;
+import net.neoforged.neoforge.capabilities.Capabilities;
+import net.neoforged.neoforge.items.IItemHandler;
+
+/**
+ * The item handler a cable reads and writes, from a NeoForge capability cache of its target.
+ *
+ * get(inventoryPos, side) returns what inventoryPos.getItemHandler(side) returns. NeoForge invalidates the cache when a
+ * block entity is placed or removed there, when its chunk loads or unloads, and whenever a provider's answer changes
+ * otherwise (its contract for providers; vanilla chests invalidate when they join or leave a double chest, and the
+ * composter's handler forwards to its current state). The cache is used only while the target is loaded, as a fresh
+ * lookup would load the chunk.
+ */
+public final class TargetItemHandler {
+
+  private BlockCapabilityCache<IItemHandler, Direction> cache;
+  private ServerLevel level;
+  private BlockPos pos;
+  private Direction side;
+
+  public IItemHandler get(DimPos inventoryPos, Direction side) {
+    Level resolved = inventoryPos.resolveLevel();
+    BlockPos blockPos = inventoryPos.getBlockPos();
+    if (!(resolved instanceof ServerLevel serverLevel) || blockPos == null || !serverLevel.isLoaded(blockPos)) {
+      return inventoryPos.getItemHandler(side);
+    }
+    if (cache == null || level != serverLevel || this.side != side || !blockPos.equals(pos)) {
+      cache = BlockCapabilityCache.create(Capabilities.ItemHandler.BLOCK, serverLevel, blockPos, side);
+      level = serverLevel;
+      pos = blockPos;
+      this.side = side;
+    }
+    return cache.getCapability();
+  }
+}
