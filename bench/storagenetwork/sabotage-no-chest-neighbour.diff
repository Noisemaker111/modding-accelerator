+package com.lothrazar.storagenetwork.api.capabilities;
+
+import com.lothrazar.storagenetwork.api.DimPos;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.core.SectionPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.CompoundContainer;
+import net.minecraft.world.Container;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.ChestBlock;
+import net.minecraft.world.level.block.entity.BarrelBlockEntity;
+import net.minecraft.world.level.block.entity.ChestBlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.properties.ChestType;
+import net.neoforged.neoforge.capabilities.BlockCapabilityCache;
+import net.neoforged.neoforge.capabilities.Capabilities;
+import net.neoforged.neoforge.items.IItemHandler;
+import net.neoforged.neoforge.items.wrapper.InvWrapper;
+
+/**
+ * The item handler a cable reads and writes, from a NeoForge capability cache of its target.
+ *
+ * get(inventoryPos, side) returns what inventoryPos.getItemHandler(side) returns, and makes the chunk accesses that
+ * lookup makes. NeoForge invalidates the cache when a block entity is placed or removed there, when its chunk loads or
+ * unloads, and whenever a provider's answer changes otherwise (its contract for providers; vanilla chests invalidate
+ * when they join or leave a double chest). A lookup also reads chunks through ServerChunkCache.getChunk(x, z, FULL,
+ * true), which renews a one-tick "unknown" ticket on each: the target's chunk, and for a double chest the chunk of its
+ * other half. Those tickets keep chunks loaded, so a cached answer makes the same calls. Only the answers of NeoForge's
+ * vanilla barrel and chest providers are cached, because their chunk accesses are known; any other target is looked up
+ * every time, as the unmodified mod does. The cache is used only while the target is loaded, as a fresh lookup would
+ * load the chunk.
+ */
+public final class TargetItemHandler {
+
+  private BlockCapabilityCache<IItemHandler, Direction> cache;
+  private ServerLevel level;
+  private BlockPos pos;
+  private Direction side;
+  // False after a lookup found a target whose chunk accesses are not known: then look up until it is a barrel or chest.
+  private boolean replayable = true;
+  // True while the cache holds an answer NeoForge has not invalidated since get() last read it.
+  private boolean known;
+
+  public IItemHandler get(DimPos inventoryPos, Direction side) {
+    Level resolved = inventoryPos.resolveLevel();
+    BlockPos blockPos = inventoryPos.getBlockPos();
+    if (!(resolved instanceof ServerLevel serverLevel) || blockPos == null || !serverLevel.isLoaded(blockPos)) {
+      return inventoryPos.getItemHandler(side);
+    }
+    if (cache == null || level != serverLevel || this.side != side || !blockPos.equals(pos)) {
+      cache = newCache(serverLevel, blockPos, side);
+      level = serverLevel;
+      pos = blockPos;
+      this.side = side;
+      replayable = true;
+    }
+    if (!replayable) {
+      IItemHandler fresh = inventoryPos.getItemHandler(side);
+      if (vanilla(fresh)) {
+        // Start from a new cache, so its first answer is a lookup made now.
+        cache = newCache(serverLevel, blockPos, side);
+        replayable = true;
+      }
+      return fresh;
+    }
+    // A lookup reads the target's chunk first (Level.getBlockState).
+    touchChunk(serverLevel, blockPos);
+    // A valid cache answers what a lookup would; an invalidated one makes the lookup now.
+    IItemHandler handler = cache.getCapability();
+    known = true;
+    if (!vanilla(handler)) {
+      // Only an invalidated cache can answer something else, and that answer came from a lookup just made.
+      replayable = false;
+      return handler;
+    }
+    Container inventory = ((InvWrapper) handler).getInv();
+    if (inventory.getClass() != BarrelBlockEntity.class) {
+      // ChestBlock.getContainer reads the neighbour its type points at unless the chest is single.
+      BlockState state = serverLevel.getBlockState(blockPos);
+      if (state.getBlock() instanceof ChestBlock && state.getValue(ChestBlock.TYPE) != ChestType.SINGLE) {
+        // sabotage: no read of the other half's chunk
+      }
+    }
+    return handler;
+  }
+
+  /**
+   * What get(inventoryPos, side) would return, without any chunk access, when the cache already knows it: the target
+   * is a vanilla barrel or chest that get() read and NeoForge has not invalidated since. Else null.
+   */
+  public IItemHandler peek(DimPos inventoryPos, Direction side) {
+    if (!known || !replayable || cache == null || this.side != side || inventoryPos.resolveLevel() != level || !pos.equals(inventoryPos.getBlockPos())) {
+      return null;
+    }
+    return cache.getCapability();
+  }
+
+  private BlockCapabilityCache<IItemHandler, Direction> newCache(ServerLevel level, BlockPos pos, Direction side) {
+    known = false;
+    return BlockCapabilityCache.create(Capabilities.ItemHandler.BLOCK, level, pos, side, () -> true, () -> known = false);
+  }
+
+  /** NeoForge's answer for a vanilla barrel, chest or double chest. */
