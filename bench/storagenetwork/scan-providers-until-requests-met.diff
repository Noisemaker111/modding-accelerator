+  private static boolean providersStayPut(RequestBatch batch, List<CapabilityConnectable> storages) {
+    Set<BlockEntity> stored = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<>());
+    for (CapabilityConnectable storage : storages) {
+      if (!(storage instanceof com.lothrazar.storagenetwork.api.capabilities.CapabilityConnectableDefault plain)) {
+        return false;
