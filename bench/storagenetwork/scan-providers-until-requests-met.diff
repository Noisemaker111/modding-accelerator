@@ -0,0 +1,57 @@
+package com.lothrazar.storagenetwork.api.capabilities;
+
+import java.util.List;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.CompoundContainer;
+import net.minecraft.world.Container;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.ChestBlock;
+import net.minecraft.world.level.block.entity.BarrelBlockEntity;
+import net.minecraft.world.level.block.entity.BlockEntity;
+import net.minecraft.world.level.block.entity.ChestBlockEntity;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.properties.ChestType;
+import net.neoforged.neoforge.items.IItemHandler;
+import net.neoforged.neoforge.items.wrapper.InvWrapper;
+
+/**
+ * Vanilla barrels and chests behind a plain InvWrapper, the inventories whose slots behave independently: a simulated
+ * extract returns the slot's own item or nothing and changes nothing, an extract of 0 returns nothing, and taking from
+ * one slot changes no other. A chest that still has loot to unpack is not plain: reading any of its slots fills it.
+ */
+public final class PlainInventories {
+
+  private PlainInventories() {}
+
+  /** The block entities whose slots handler reads and writes, at pos in level, when they are plain; else null. */
+  public static List<BlockEntity> of(IItemHandler handler, Level level, BlockPos pos) {
+    if (handler == null || handler.getClass() != InvWrapper.class || level == null || pos == null) {
+      return null;
+    }
+    Container inventory = ((InvWrapper) handler).getInv();
+    if (inventory != null && (inventory.getClass() == BarrelBlockEntity.class || inventory.getClass() == ChestBlockEntity.class)) {
+      return plain((BlockEntity) inventory) ? List.of((BlockEntity) inventory) : null;
+    }
+    if (inventory == null || inventory.getClass() != CompoundContainer.class) {
+      return null;
+    }
+    BlockState state = level.getBlockState(pos);
+    if (!state.hasProperty(ChestBlock.TYPE) || state.getValue(ChestBlock.TYPE) == ChestType.SINGLE) {
+      return null;
+    }
+    BlockEntity here = level.getBlockEntity(pos);
+    BlockEntity other = level.getBlockEntity(pos.relative(ChestBlock.getConnectedDirection(state)));
+    if (here == null || other == null || here == other || here.getClass() != ChestBlockEntity.class || other.getClass() != ChestBlockEntity.class) {
+      return null;
+    }
+    CompoundContainer both = (CompoundContainer) inventory;
+    if (!both.contains((Container) here) || !both.contains((Container) other) || !plain(here) || !plain(other)) {
+      return null;
+    }
+    return List.of(here, other);
+  }
+
+  private static boolean plain(BlockEntity entity) {
+    return ((net.minecraft.world.RandomizableContainer) entity).getLootTable() == null;
+  }
+}
