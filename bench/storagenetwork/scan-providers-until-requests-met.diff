+      if (plain.listsNoProviders()) {
+        continue;
+      }
+      List<BlockEntity> inventories = plain.plainInventory();
+      if (inventories == null) {
+        return false;
+      }
+      for (BlockEntity inventory : inventories) {
+        if (!stored.add(inventory)) {
+          return false;
+        }
+      }
