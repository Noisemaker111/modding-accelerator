+    for (int slot = 0; slot < itemHandler.getSlots(); slot++) {
+      if (itemHandler.getStackInSlot(slot).getItem() != item) {
+        continue;
+      }
+      if (done.getAsBoolean()) {
+        return false;
+      }
+      ItemStack stack = itemHandler.extractItem(slot, 1, true);
+      if (stack == null || stack.isEmpty() || filters.isStackFiltered(stack) || stack.getItem() != item) {
+        continue;
+      }
+      batch.extractStacks(this, slot, item);
+    }
+    return true;
+  }
