+package com.github.L_Ender.lionfishapi.server;
+
+/** Switch for the fluid-standing check in EntityMixin: each distinct block once (true), or every offset as before. */
+public final class FluidStanding {
+    public static boolean DISTINCT_BLOCKS = true;
+
+    private FluidStanding() {}
+}
