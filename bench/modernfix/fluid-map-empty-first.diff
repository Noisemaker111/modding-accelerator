@@ -0,0 +1,8 @@
+package org.embeddedt.modernfix.forge.util;
+
+/** Switch for the fluid_pushing_alloc mixin: start each entity's map of touched fluid types empty instead of full size. */
+public final class FluidPushingMaps {
+    public static boolean EMPTY_FIRST = true;
+
+    private FluidPushingMaps() {}
+}
