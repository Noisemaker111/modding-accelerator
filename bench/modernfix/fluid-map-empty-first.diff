+++ b/forge/src/main/java/org/embeddedt/modernfix/forge/mixin/perf/fluid_pushing_alloc/EntityMixin.java
@@ -0,0 +1,25 @@
+package org.embeddedt.modernfix.forge.mixin.perf.fluid_pushing_alloc;
+
+import it.unimi.dsi.fastutil.objects.Object2ObjectArrayMap;
+import net.minecraft.world.entity.Entity;
+import org.embeddedt.modernfix.forge.util.FluidPushingMaps;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Redirect;
+
+import java.util.function.Predicate;
+
+@Mixin(Entity.class)
+public class EntityMixin {
+    /**
+     * @author mmt
+     * @reason Forge sizes the per-call map of fluid types an entity touches to the number of registered fluid types,
+     * so every entity allocates two arrays that long every tick, though most touch no fluid and the rest one or two.
+     * An empty map shares fastutil's empty arrays and grows as fluids are found, keeping their insertion order.
+     */
+    @Redirect(method = "updateFluidHeightAndDoFluidPushing(Ljava/util/function/Predicate;)V",
+            at = @At(value = "NEW", target = "(I)Lit/unimi/dsi/fastutil/objects/Object2ObjectArrayMap;"), remap = false)
+    private Object2ObjectArrayMap<?, ?> mfix$emptyFluidMap(int capacity) {
+        return FluidPushingMaps.EMPTY_FIRST ? new Object2ObjectArrayMap<>() : new Object2ObjectArrayMap<>(capacity);
+    }
+}
