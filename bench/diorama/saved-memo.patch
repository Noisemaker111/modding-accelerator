+	/**
+	 * Whether a pick remembers {@link TileSpots#passedWhenSaved}'s answer for each block of the
+	 * column of x it is picking: a tile's spots are picked a column at a time, and the rays of a
+	 * column's neighbouring rows cross the same blocks of a chunk the map has no data for, each
+	 * asking again. The answer depends only on the tile, its saved spots and the block. Only for
+	 * checking that spots come out the same either way.
+	 */
+	public static boolean REMEMBER_PASSED = true;
+	/** The column of x {@link #passed} holds answers for. */
+	private int passedX = Integer.MIN_VALUE;
+	/** Per block (y, z) of column {@link #passedX}: 1 passed, 2 not. */
+	private final it.unimi.dsi.fastutil.longs.Long2ByteOpenHashMap passed = new it.unimi.dsi.fastutil.longs.Long2ByteOpenHashMap();
+
+	private boolean passedWhenSaved(int x, int y, int z) {
+		if (!REMEMBER_PASSED) {
+			return TileSpots.passedWhenSaved(this.tile, this.savedSpots, x, y, z);
+		}
+		if (x != this.passedX) {
+			this.passed.clear();
+			this.passedX = x;
+		}
+		long key = ((long) y << 32) | (z & 0xFFFFFFFFL);
+		byte known = this.passed.get(key);
+		if (known == 0) {
+			known = TileSpots.passedWhenSaved(this.tile, this.savedSpots, x, y, z) ? (byte) 1 : (byte) 2;
+			this.passed.put(key, known);
+		}
+		return known == 1;
+	}
