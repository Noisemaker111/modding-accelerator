+		double tMaxZ;
+
+		Steps(int top, double v, double sin, double cos) {
+			double z0 = (v + top * cos) / sin;
+			this.by = top - 1;
+			this.bz = (int) Math.floor(z0);
+			this.tMaxY = 1 / sin;
+			this.tMaxZ = (z0 - this.bz) / cos;
+			this.y[0] = this.by;
+			this.z[0] = this.bz;
