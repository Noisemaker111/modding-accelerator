+				this.z = java.util.Arrays.copyOf(this.z, this.y.length);
+			}
+			while (this.length < need) {
+				if (this.tMaxY < this.tMaxZ) {
+					this.by--;
+					this.tMaxY += 1 / sin;
+				} else {
+					this.bz--;
+					this.tMaxZ += 1 / cos;
+				}
+				this.y[this.length] = this.by;
