+	 * ray's steps depend only on its height to start from and its map v, never on its x, so with
+	 * one start height every ray of a pixel row steps through the same cells: they are worked out
+	 * once per row, with the same arithmetic as a lone ray's, and each ray reads them.
+	 */
+	private static final class Steps {
+		int[] y = new int[64];
+		int[] z = new int[64];
+		int length;
+		int by;
+		int bz;
