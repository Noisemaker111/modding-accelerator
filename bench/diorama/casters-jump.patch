+	/**
+	 * Whether {@link #casterChunk} jumps down a column straight to the next block that may cast, with
+	 * {@link #casterColumns}, instead of testing every block's bit: under the surface nearly every
+	 * block is rock under rock. It visits the same blocks in the same order. Only for checking that
+	 * casters come out the same either way.
+	 */
+	public static boolean CASTER_JUMP = true;
+
+	/**
+	 * {@link #casterSection} turned on its side: per column {@code (z << 4) | x}, a bit per y in the
+	 * section for each block that may cast. Null where {@link #casterSection} is. Don't write to it.
+	 */
+	char @Nullable [] casterColumns(int sx, int sy, int sz) {
+		long[] bits = this.casterSection(sx, sy, sz);
+		if (bits == null) {
+			return null;
+		}
+		Decoded chunk = this.chunk(sx, sz);
+		int index = sy - chunk.snapshot.minSectionY;
+		char[] columns = chunk.casterColumns[index];
+		if (columns == null) {
+			columns = new char[256];
+			for (int w = 0; w < 64; w++) {
+				long word = bits[w];
+				while (word != 0) {
+					int i = (w << 6) | Long.numberOfTrailingZeros(word);
+					columns[i & 255] |= (char) (1 << (i >> 8));
+					word &= word - 1;
+				}
+			}
+			chunk.casterColumns[index] = columns;
+		}
+		return columns;
+	}
