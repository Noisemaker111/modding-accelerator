diff --git a/src/main/java/dev/diorama/render/MapLevel.java b/src/main/java/dev/diorama/render/MapLevel.java
index 370b86b4..14f7e518 100644
--- a/src/main/java/dev/diorama/render/MapLevel.java
+++ b/src/main/java/dev/diorama/render/MapLevel.java
@@ -68,7 +68,12 @@ public final class MapLevel implements ChunkSource {
 		task -> {
 			Thread thread = new Thread(task, "diorama-baker-" + THREAD_ID.incrementAndGet());
 			thread.setDaemon(true);
-			thread.setPriority(Thread.MIN_PRIORITY + 1);
+			// Normal priority, as the game's own threads have. Below it, a machine busy with other programs
+			// can leave a baker unscheduled for seconds (Windows lets a starved thread wait about four),
+			// and whenever the JVM stops every thread at a safepoint (a garbage collection, say) the whole
+			// game, render thread included, waits for that baker to reach its stop. The same goes for the
+			// save import and the tile writer. There are at most a third as many bakers as cores.
+			thread.setPriority(Thread.NORM_PRIORITY);
 			return thread;
 		}
 	);
