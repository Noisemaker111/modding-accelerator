+		return this;
+	}
+
+	/** A section's worth of ids to write whole: a spare when this reader pools, otherwise a new array. */
+	private int[] section() {
+		java.util.ArrayList<int[]> lent = this.lent;
+		if (lent == null) {
+			return new int[4096];
+		}
+		int[] ids = SPARE.get().pollFirst();
+		if (ids == null) {
+			ids = new int[4096];
+		}
+		lent.add(ids);
+		return ids;
+	}
+
+	/** Ends the job: gives the arrays back and forgets every chunk, so nothing here is read again. */
+	void release() {
+		java.util.ArrayList<int[]> lent = this.lent;
+		if (lent == null) {
+			return;
+		}
+		this.lent = null;
+		this.cache.clear();
+		Arrays.fill(this.tableX, Integer.MIN_VALUE);
+		Arrays.fill(this.tableChunk, null);
+		this.sectionX = Integer.MIN_VALUE;
+		this.sectionIds = null;
+		java.util.ArrayDeque<int[]> spare = SPARE.get();
+		for (int[] ids : lent) {
+			if (spare.size() >= SPARES) {
+				break;
+			}
+			spare.addFirst(ids);
+		}
+	}
