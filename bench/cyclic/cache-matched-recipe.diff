+      if (scannedGrid[i].is(net.minecraft.world.item.Items.FILLED_MAP)) {
+        cacheable = false;
+      }
+    }
+    scannedRecipes = cacheable ? allRecipes : null;
+    scannedResult = found;
+    return found;
+  }
