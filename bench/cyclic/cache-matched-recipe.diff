+  // The last scan's answer, kept while the grid holds equal stacks (item, count, components) and the server's
+  // recipes are the same set: RecipeManager replaces its map on every reload or replaceRecipes, so the identity
+  // of getRecipes() says when they change. A grid holding a filled map is always scanned: the map extending
+  // recipe's match reads the map's saved data from the level.
+  private java.util.Collection<RecipeHolder<?>> scannedRecipes;
+  private final ItemStack[] scannedGrid = new ItemStack[GRID_SIZE];
