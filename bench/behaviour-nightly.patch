           path: ${{ runner.temp }}/real-mods-results
           if-no-files-found: ignore
+  behaviour:
+    # The real-game behaviour checks (bench/behaviour_checks.sh): AppleSkin's HUD estimate and Zombie
+    # Apocalypse's AI in a hidden, quiet client on Xvfb with software OpenGL, each passing on the mod and
